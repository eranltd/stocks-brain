{
  "$id": "calibration.schema.json",
  "title": "Conviction calibration (data/kb/calibration.json)",
  "description": "Does conviction carry information? Computed from scored outcomes. No LLM.",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of", "sample", "n", "min_n", "conviction_verdict", "by_conviction", "by_stance"],
  "properties": {
    "as_of": {"$ref": "common.schema.json#/$defs/date"},
    "sample": {"type": "boolean"},
    "n": {"type": "integer", "minimum": 0},
    "min_n": {"type": "integer", "minimum": 1},
    "conviction_verdict": {"enum": ["informative", "not_informative", "insufficient_data"]},
    "by_conviction": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "by_stance": {"type": "array", "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["n", "hit_rate_pct", "avg_excess_pct"],
      "properties": {
        "conviction": {"enum": ["low", "medium", "high"]},
        "stance": {"enum": ["bullish", "bearish", "neutral"]},
        "n": {"type": "integer", "minimum": 0},
        "hit_rate_pct": {"type": ["number", "null"]},
        "avg_excess_pct": {"type": ["number", "null"]}
      }
    }
  }
}
