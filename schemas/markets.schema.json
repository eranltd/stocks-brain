{
  "$id": "markets.schema.json",
  "title": "Markets (config/markets.json)",
  "description": "The lists the header switch shows. The default market is the main list (config/watchlist.json, data/market/) that every other routine reads; the others get derived numbers, the checklist and candles only, under data/markets/<id>/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updated_at",
    "change_note",
    "default",
    "markets"
  ],
  "properties": {
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "change_note": {
      "$ref": "common.schema.json#/$defs/change_note"
    },
    "default": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,20}$"
    },
    "markets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "name",
          "kind",
          "watchlist",
          "benchmark",
          "benchmark_label",
          "data",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,20}$"
          },
          "label": {
            "type": "string",
            "minLength": 2,
            "maxLength": 12,
            "description": "The word on the header switch."
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60
          },
          "kind": {
            "enum": [
              "stocks",
              "funds"
            ],
            "description": "stocks: list items carry a GICS sector; funds: a fund category."
          },
          "watchlist": {
            "type": "string",
            "pattern": "^config/(watchlist|watchlists/[a-z][a-z0-9_]{1,20})\\.json$"
          },
          "benchmark": {
            "$ref": "common.schema.json#/$defs/ticker"
          },
          "benchmark_label": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60
          },
          "data": {
            "type": "string",
            "pattern": "^data/(market|markets/[a-z][a-z0-9_]{1,20})$",
            "description": "Where the market's derived.json, checklist.json and candles/ are published."
          },
          "note": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          }
        }
      }
    }
  }
}
