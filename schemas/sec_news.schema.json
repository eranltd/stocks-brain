{
  "$id": "sec_news.schema.json",
  "title": "Official company news from SEC filings (data/market/sec_news.json)",
  "description": "Written by scripts/sec_news.py only, from the SEC's public filings index. No LLM and no text copied from filings: titles are fixed plain words for each 8-K item code or form. Point in time (filed on or before as_of).",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of", "sample", "source", "window_days", "companies", "missing"],
  "properties": {
    "as_of": {"$ref": "common.schema.json#/$defs/date"},
    "sample": {"type": "boolean"},
    "source": {"type": "string", "minLength": 3, "maxLength": 120},
    "window_days": {"type": "integer", "minimum": 7, "maximum": 400},
    "missing": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/ticker"}},
    "companies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["symbol", "cik", "name", "filings"],
        "properties": {
          "symbol": {"$ref": "common.schema.json#/$defs/ticker"},
          "cik": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1, "maxLength": 160},
          "filings": {
            "type": "array", "maxItems": 12,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["date", "form", "items", "titles", "kind", "url"],
              "properties": {
                "date": {"$ref": "common.schema.json#/$defs/date"},
                "form": {"enum": ["8-K", "8-K/A", "6-K", "6-K/A", "10-Q", "10-Q/A", "10-K", "10-K/A", "20-F", "20-F/A", "40-F", "40-F/A"]},
                "items": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]\\.[0-9]{2}$"}},
                "titles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3, "maxLength": 120}},
                "kind": {"enum": ["results", "warning", "people", "deal", "money", "other", "update", "report"]},
                "url": {"type": "string", "pattern": "^https://www\\.sec\\.gov/Archives/edgar/data/[0-9]+/[0-9]+(/[A-Za-z0-9._-]+)?$"}
              }
            }
          }
        }
      }
    }
  }
}
