            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "status",
              "sector"
            ],
            "properties": {
              "symbol": {
                "$ref": "common.schema.json#/$defs/ticker"
              },
              "status": {
                "enum": [
