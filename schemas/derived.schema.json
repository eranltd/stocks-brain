{
  "$id": "derived.schema.json",
  "title": "Derived market view (data/market/derived.json)",
  "description": "Public numbers computed from provider bars: returns, distances, breadth and sparklines indexed to 100. Contains no absolute prices; raw bars are never committed (provider terms).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "as_of",
    "sample",
    "provider",
    "benchmark",
    "breadth_above_sma50_pct",
    "symbols"
  ],
  "properties": {
    "as_of": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "sample": {
      "type": "boolean"
    },
    "provider": {
      "type": "string",
      "maxLength": 40
    },
    "benchmark": {
      "$ref": "common.schema.json#/$defs/ticker"
    },
    "breadth_above_sma50_pct": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "symbols": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "last_date",
          "change_1d_pct",
          "ret_20d_pct",
          "ret_60d_pct",
          "dist_sma50_pct",
          "above_sma50",
          "spark"
        ],
        "properties": {
          "symbol": {
            "$ref": "common.schema.json#/$defs/ticker"
          },
          "last_date": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "change_1d_pct": {
            "type": "number"
          },
          "ret_20d_pct": {
            "type": "number"
          },
          "ret_60d_pct": {
            "type": "number"
          },
          "vs_bench_20d_pct": {
            "type": "number"
          },
          "dist_sma50_pct": {
            "type": "number"
          },
          "above_sma50": {
            "type": "boolean"
          },
          "spark": {
            "type": "array",
            "maxItems": 260,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "v"
              ],
              "properties": {
                "date": {
                  "$ref": "common.schema.json#/$defs/date"
                },
                "v": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "from_high_pct": {
            "type": "number",
            "maximum": 0
          },
          "vol20_pct": {
            "type": "number",
            "minimum": 0
          },
          "series": {
            "type": "array",
            "maxItems": 1000,
            "description": "Whole window indexed to 100 at its first bar; sma50 on the same index.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "v"
              ],
              "properties": {
                "date": {
                  "$ref": "common.schema.json#/$defs/date"
                },
                "v": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "sma50": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "ret_120d_pct": {
            "type": "number"
          },
          "ret_250d_pct": {
            "type": "number"
          },
          "vs_bench_60d_pct": {
            "type": "number"
          },
          "vs_bench_120d_pct": {
            "type": "number"
          },
          "vs_bench_250d_pct": {
            "type": "number"
          },
          "setup": {
            "type": "object",
            "required": [
              "checks",
              "passed",
              "stretched"
            ],
            "description": "Setup checks v2 (docs/methodology.md). Code only, not a recommendation.",
            "properties": {
              "checks": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "trend",
                  "rs_3m",
                  "rs_6m",
                  "calm"
                ],
                "properties": {
                  "trend": {
                    "type": "boolean"
                  },
                  "rs_3m": {
                    "type": "boolean"
                  },
                  "rs_6m": {
                    "type": "boolean"
                  },
                  "calm": {
                    "type": "boolean"
                  }
                }
              },
              "passed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "stretched": {
                "type": "boolean"
              }
            }
          },
          "risk": {
            "type": "object",
            "required": [
              "ret_1y_pct",
              "max_dd_1y_pct",
              "worst_20d_1y_pct",
              "vol_1y_pct",
              "loss_95_20d_pct"
            ],
            "properties": {
              "ret_1y_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "max_dd_1y_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "worst_20d_1y_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "vol_1y_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "loss_95_20d_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "beta_1y": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "corr_1y": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "vs_bench_1y_pct": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "basket": {
      "type": "object",
      "description": "Equal-weight watchlist basket vs the benchmark, percent only."
    },
    "context": {
      "type": "object",
      "description": "Cash hurdle, equal vs cap weight participation, bonds, credit, core trend filter. Percent only."
    },
    "base_rates": {
      "type": "object",
      "required": [
        "all",
        "by_score",
        "by_check",
        "gate",
        "horizon_days"
      ],
      "description": "Historical forward excess return vs the benchmark by setup state (code backtest, non-overlapping samples)."
    }
  }
}
