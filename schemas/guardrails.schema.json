{
  "$id": "guardrails.schema.json",
  "title": "Guardrails (docs/guardrails.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated_at", "change_note", "max_picks", "allowed_stances",
               "picks_must_be_on_watchlist", "no_digits_in_pick_text", "banned_phrases", "forbidden_keys"],
  "properties": {
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "updated_at": {"$ref": "common.schema.json#/$defs/date"},
    "change_note": {"$ref": "common.schema.json#/$defs/change_note"},
    "max_picks": {"type": "integer", "minimum": 0, "maximum": 10},
    "allowed_stances": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["bullish", "bearish", "neutral"]}},
    "picks_must_be_on_watchlist": {"type": "boolean"},
    "no_digits_in_pick_text": {"type": "boolean", "description": "Numbers are computed by code. Pick prose must not contain digits."},
    "banned_phrases": {"type": "array", "items": {"type": "string", "minLength": 2}},
    "forbidden_keys": {"type": "array", "items": {"type": "string", "pattern": "^[a-z_]+$"}}
  }
}
