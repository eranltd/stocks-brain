{
  "$id": "themes.schema.json",
  "title": "Theme hunter (config/themes.json)",
  "description": "Themes (space, AI, ...) and their companies, each with our short reading of its competition. Each company names the market whose list carries it (its numbers come from that market).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updated_at",
    "change_note",
    "how_to_read",
    "themes"
  ],
  "properties": {
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "change_note": {
      "$ref": "common.schema.json#/$defs/change_note"
    },
    "how_to_read": {
      "type": "string",
      "minLength": 10,
      "maxLength": 400
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "why",
          "companies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,23}$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 30
          },
          "why": {
            "type": "string",
            "minLength": 10,
            "maxLength": 240
          },
          "companies": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "symbol",
                "market",
                "moat",
                "note"
              ],
              "properties": {
                "symbol": {
                  "$ref": "common.schema.json#/$defs/ticker"
                },
                "market": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{1,23}$"
                },
                "moat": {
                  "enum": [
                    "dominant",
                    "few_rivals",
                    "crowded"
                  ]
                },
                "note": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 160
                }
              }
            }
          }
        }
      }
    }
  }
}
