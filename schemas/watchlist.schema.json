{
  "$id": "watchlist.schema.json",
  "title": "Watchlist (config/watchlist.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updated_at",
    "change_note",
    "symbols"
  ],
  "properties": {
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "change_note": {
      "$ref": "common.schema.json#/$defs/change_note"
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "name"
        ],
        "properties": {
          "symbol": {
            "$ref": "common.schema.json#/$defs/ticker"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 4,
            "items": {
              "$ref": "common.schema.json#/$defs/ticker"
            },
            "description": "Other tickers for the same company (share classes), used to match claims."
          },
          "sector": {
            "enum": [
              "Information Technology",
              "Communication Services",
              "Consumer Discretionary",
              "Consumer Staples",
              "Health Care",
              "Financials",
              "Industrials",
              "Energy",
              "Materials",
              "Utilities",
              "Real Estate"
            ],
            "description": "GICS sector, used for the portfolio diversification rule (max names per sector)."
          },
          "category": {
            "$ref": "#/$defs/fund_category"
          }
        },
        "anyOf": [
          {
            "required": [
              "sector"
            ]
          },
          {
            "required": [
              "category"
            ]
          }
        ],
        "description": "A company has a GICS sector; an index fund (a market of kind funds) has a category instead. Lint checks which one per market."
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "label"
      ],
      "description": "Public proxy for the household's core index fund (no holdings). Must also be listed in context.",
      "properties": {
        "symbol": {
          "$ref": "common.schema.json#/$defs/ticker"
        },
        "label": {
          "type": "string",
          "maxLength": 60
        }
      }
    },
    "context": {
      "type": "array",
      "maxItems": 20,
      "description": "Market-context instruments: fetched and derived like the watchlist, but never picked.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "name",
          "role"
        ],
        "properties": {
          "symbol": {
            "$ref": "common.schema.json#/$defs/ticker"
          },
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "role": {
            "enum": [
              "spx",
              "cash",
              "eq_ndx",
              "eq_spx",
              "bonds",
              "credit",
              "other"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "fund_category": {
      "enum": [
        "US large companies",
        "US mid-size companies",
        "US small companies",
        "World",
        "Developed markets outside the US",
        "Emerging markets",
        "Single country",
        "Sector",
        "Bonds",
        "Cash"
      ],
      "description": "Plain category of an index fund (a funds market's list has a category instead of a GICS sector)."
    }
  }
}
