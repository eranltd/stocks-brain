{
  "$id": "routines.schema.json",
  "title": "Routine registry (config/routines.json)",
  "description": "The operating rhythm. Each routine is code-first; an LLM step is explicit and cost-capped.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated_at", "change_note", "timezone", "routines"],
  "properties": {
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "updated_at": {"$ref": "common.schema.json#/$defs/date"},
    "change_note": {"$ref": "common.schema.json#/$defs/change_note"},
    "timezone": {"const": "UTC"},
    "routines": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "cadence", "cron", "status", "milestone", "uses_llm", "max_cost_usd",
                     "inputs", "outputs", "human_gate", "why"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$"},
          "name": {"type": "string", "minLength": 3, "maxLength": 60},
          "cadence": {"enum": ["daily", "weekly", "monthly", "on_demand"]},
          "cron": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9*/,\\-]+ [0-9*/,\\-]+ [0-9*/,\\-]+ [0-9*/,\\-]+ [0-9*/,\\-]+$"}]},
          "status": {"enum": ["planned", "active", "paused"]},
          "milestone": {"type": "string", "pattern": "^M\\d+$"},
          "uses_llm": {"type": "boolean"},
          "max_cost_usd": {"type": "number", "minimum": 0},
          "inputs": {"type": "array", "items": {"type": "string", "maxLength": 60}},
          "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 80}},
          "human_gate": {"type": "boolean", "description": "true when the output is a proposal a person must merge"},
          "why": {"type": "string", "minLength": 20, "maxLength": 320}
        }
      }
    }
  }
}
