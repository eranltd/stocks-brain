{
  "$id": "learnings.schema.json",
  "title": "Learnings (docs/learnings.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated_at", "change_note", "items"],
  "properties": {
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "updated_at": {"$ref": "common.schema.json#/$defs/date"},
    "change_note": {"$ref": "common.schema.json#/$defs/change_note"},
    "items": {
      "type": "array", "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "added", "status", "lesson", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^L-\\d{3}$"},
          "added": {"$ref": "common.schema.json#/$defs/date"},
          "status": {"enum": ["active", "retired"]},
          "lesson": {"type": "string", "minLength": 10, "maxLength": 300},
          "evidence": {"type": "array", "minItems": 1, "maxItems": 10,
                       "items": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}:[A-Z][A-Z0-9.\\-]{0,9}$"}}
        }
      }
    }
  }
}
