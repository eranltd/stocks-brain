{
  "$id": "settings.schema.json",
  "title": "Settings (config/settings.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated_at", "change_note", "pack", "cost", "llm", "scoring", "regime", "prices", "lint", "site"],
  "properties": {
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "updated_at": {"$ref": "common.schema.json#/$defs/date"},
    "change_note": {"$ref": "common.schema.json#/$defs/change_note"},
    "pack": {"type": "object", "additionalProperties": false,
             "required": ["token_cap", "recent_runs", "price_lookback_days", "library_principles_max"],
             "properties": {"token_cap": {"type": "integer", "minimum": 1000, "maximum": 200000},
                            "recent_runs": {"type": "integer", "minimum": 0, "maximum": 30},
                            "price_lookback_days": {"type": "integer", "minimum": 5, "maximum": 260},
                            "library_principles_max": {"type": "integer", "minimum": 0, "maximum": 200}}},
    "cost": {"type": "object", "additionalProperties": false,
             "required": ["target_usd", "warn_usd", "hard_cap_usd"],
             "properties": {"target_usd": {"type": "number", "exclusiveMinimum": 0},
                            "warn_usd": {"type": "number", "exclusiveMinimum": 0},
                            "hard_cap_usd": {"type": "number", "exclusiveMinimum": 0}}},
    "llm": {"type": "object", "additionalProperties": false,
            "required": ["model", "max_output_tokens", "repair_retries"],
            "properties": {"model": {"type": ["string", "null"]},
                           "max_output_tokens": {"type": "integer", "minimum": 100, "maximum": 16000},
                           "repair_retries": {"type": "integer", "minimum": 0, "maximum": 1}}},
    "scoring": {"type": "object", "additionalProperties": false,
                "required": ["horizon_days", "flat_band_pct", "calibration_min_n", "benchmark"],
                "properties": {"horizon_days": {"type": "integer", "minimum": 1, "maximum": 260},
                               "flat_band_pct": {"type": "number", "minimum": 0},
                               "calibration_min_n": {"type": "integer", "minimum": 1},
                               "benchmark": {"type": "object", "additionalProperties": false,
                                             "required": ["symbol", "label"],
                                             "properties": {"symbol": {"$ref": "common.schema.json#/$defs/ticker"},
                                                            "label": {"type": "string", "maxLength": 60}}}}},
    "regime": {"type": "object", "additionalProperties": false,
               "required": ["vol_days", "vol_calm_pct", "vol_stressed_pct", "drawdown_days", "drawdown_stressed_pct", "trend_sma_days", "slope_days"],
               "properties": {"vol_days": {"type": "integer", "minimum": 5, "maximum": 120},
                              "vol_calm_pct": {"type": "number", "exclusiveMinimum": 0},
                              "vol_stressed_pct": {"type": "number", "exclusiveMinimum": 0},
                              "drawdown_days": {"type": "integer", "minimum": 20, "maximum": 1000},
                              "drawdown_stressed_pct": {"type": "number", "exclusiveMinimum": 0},
                              "trend_sma_days": {"type": "integer", "minimum": 5, "maximum": 200},
                              "slope_days": {"type": "integer", "minimum": 1, "maximum": 60}}},
    "prices": {"type": "object", "additionalProperties": false,
               "required": ["provider", "keep_days"],
               "properties": {"provider": {"type": ["string", "null"]},
                              "keep_days": {"type": "integer", "minimum": 20, "maximum": 1000}}},
    "lint": {"type": "object", "additionalProperties": false,
             "required": ["max_file_kb", "max_total_data_mb"],
             "properties": {"max_file_kb": {"type": "integer", "minimum": 16},
                            "max_total_data_mb": {"type": "number", "exclusiveMinimum": 0}}},
    "site": {"type": "object", "additionalProperties": false,
             "required": ["title", "repo", "runs_shown", "sparkline_days"],
             "properties": {"title": {"type": "string", "maxLength": 40},
                            "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.\\-]+/[A-Za-z0-9_.\\-]+$"},
                            "runs_shown": {"type": "integer", "minimum": 1, "maximum": 365},
                            "sparkline_days": {"type": "integer", "minimum": 5, "maximum": 260}}}
  }
}
