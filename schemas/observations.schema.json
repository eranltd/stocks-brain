{
  "$id": "observations.schema.json",
  "title": "Dated observations (data/kb/observations.json)",
  "description": "Time-bound, third-party claims (market readings, company news, adoption figures) from library sources. Unlike principles they expire, and they stay 'unverified' until code confirms them against data. The packer passes only unexpired ones, labelled as claims.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated_at", "change_note", "sample", "items"],
  "properties": {
    "version": {"$ref": "common.schema.json#/$defs/semver"},
    "updated_at": {"$ref": "common.schema.json#/$defs/date"},
    "change_note": {"$ref": "common.schema.json#/$defs/change_note"},
    "sample": {"type": "boolean"},
    "items": {
      "type": "array", "maxItems": 2000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source_id", "as_of", "expires", "kind", "tickers", "text", "tags", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^O-\\d{4}$"},
          "source_id": {"type": "string", "pattern": "^S-\\d{3}$"},
          "as_of": {"$ref": "common.schema.json#/$defs/date"},
          "expires": {"$ref": "common.schema.json#/$defs/date"},
          "kind": {"enum": ["market", "company", "sector", "theme"]},
          "tickers": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/ticker"}},
          "text": {"type": "string", "minLength": 15, "maxLength": 280},
          "tags": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,29}$"}},
          "status": {"enum": ["unverified", "confirmed", "contradicted"]}
        }
      }
    }
  }
}
