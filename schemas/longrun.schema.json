                  "added",
                  "fails_checks",
                  "stretched",
                  "slots_full",
                  "sector_cap",
                  "too_correlated",
                  "no_history"
                ]
              },
              "sector": {
                "type": "string",
                "maxLength": 40
              },
              "passed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "stretched": {
                "type": "boolean"
              },
              "vs_bench_long_pct": {
                "type": "number"
              }
            }
