{
  "$id": "prices.schema.json",
  "title": "Daily bars for one symbol (data/prices/<SYMBOL>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["symbol", "provider", "currency", "fetched_at", "sample", "bars"],
  "properties": {
    "symbol": {"$ref": "common.schema.json#/$defs/ticker"},
    "provider": {"type": "string", "minLength": 1, "maxLength": 40},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "fetched_at": {"$ref": "common.schema.json#/$defs/datetime"},
    "sample": {"type": "boolean"},
    "bars": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["date", "open", "high", "low", "close", "volume"],
        "properties": {
          "date": {"$ref": "common.schema.json#/$defs/date"},
          "open": {"type": "number", "exclusiveMinimum": 0},
          "high": {"type": "number", "exclusiveMinimum": 0},
          "low": {"type": "number", "exclusiveMinimum": 0},
          "close": {"type": "number", "exclusiveMinimum": 0},
          "volume": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
